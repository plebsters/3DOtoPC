<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>3DO Launcher</AssemblyName>
    <Product>3DO Launcher</Product>
    <AssemblyTitle>3DO Launcher</AssemblyTitle>
    <RootNamespace>TdoLauncher</RootNamespace>
    <!-- Lets the project build on non-Windows machines too (CI, checks). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
