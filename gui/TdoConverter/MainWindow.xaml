<Window x:Class="TdoConverter.MainWindow"
        Icon="pack://application:,,,/3do2pc.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3DO to PC" Width="1200" Height="800" MinWidth="1000" MinHeight="660"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <DockPanel>
        <!-- ===== Header: logo, tabs, compiler status, settings ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="22,0" Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/3do2pc.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="3DO to PC" FontSize="18" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0E1013"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SingleTab" Style="{StaticResource TabRadio}" Content="Single game" IsChecked="True"
                                     GroupName="Tabs" Checked="Tab_Checked" />
                        <RadioButton x:Name="BatchTab" Style="{StaticResource TabRadio}" Content="Batch convert"
                                     GroupName="Tabs" Checked="Tab_Checked" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" VerticalAlignment="Center" Background="#0E1013" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToolchainDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToolchainText" Text="Looking for a compiler…" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Grid.Column="3" Margin="12,0,0,0" Width="38" Padding="0" ToolTip="More"
                        Click="Settings_Click" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open the games folder" Click="OpenGames_Click" />
                            <MenuItem Header="Copy the log" Click="CopyLog_Click" />
                            <Separator />
                            <MenuItem x:Name="AboutItem" Header="3DO to PC" IsEnabled="False" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Grid Margin="22">
            <!-- ===== Single game ===== -->
            <Grid x:Name="SingleView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <!-- Convert / Inspect at the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButton}" Content="Convert" Click="Convert_Click" />
                        <Button x:Name="InspectButton" Style="{StaticResource LinkButton}" Content="Inspect disc (list its files)"
                                HorizontalAlignment="Center" Margin="0,10,0,0" Click="Inspect_Click" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Cover card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Border x:Name="CoverFrame" Width="224" Height="168" CornerRadius="10" Background="#0E1013"
                                                BorderBrush="{StaticResource InputLineBrush}" BorderThickness="1" ClipToBounds="True"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Image x:Name="CoverImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <StackPanel x:Name="CoverEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE958;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                                                               Foreground="#4A515C" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="CoverEmptyText" Text="Drop a 3DO disc here" Margin="0,10,0,0"
                                                               Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="190" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="240,0,0,0" VerticalAlignment="Top">
                                            <TextBlock x:Name="CoverTitle" Text="No disc yet" FontSize="19" FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="CoverInfo" Text="Choose a .cue, .iso or .bin image, or drop one onto this window."
                                                       Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                            <StackPanel x:Name="CoverSourceRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                                <TextBlock x:Name="CoverSourceIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{StaticResource GoodBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,3,6,0" />
                                                <TextBlock x:Name="CoverSource" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                                           MaxWidth="150" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="ChooseDiscButton" Content="Choose disc…" Click="BrowseDisc_Click" />
                                        <Button x:Name="ChangeCoverButton" Content="Change cover…" Margin="8,0,0,0" Click="ChangeCover_Click"
                                                IsEnabled="False" ToolTip="Pick a picture for the game's window and exe icon" />
                                        <Button x:Name="ResetCoverButton" Style="{StaticResource LinkButton}" Content="Use the disc's"
                                                Margin="12,0,0,0" Click="ResetCover_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Name, folder, advanced -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Game name" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                                    <TextBox x:Name="NameBox" ToolTip="Names the exe and its window. Empty: the title from the disc's file name." />
                                    <TextBlock Text="Save to" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutBox" />
                                        <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Click="BrowseOut_Click" />
                                    </Grid>

                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Advanced" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AdvancedSummary" Text="build .exe · release build" Style="{StaticResource Muted}"
                                                               FontSize="12" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button x:Name="AdvancedToggle" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Show"
                                                        Click="AdvancedToggle_Click" />
                                            </Grid>
                                            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <CheckBox x:Name="BuildCheck" Content="Build the .exe" IsChecked="True" Checked="Options_Changed"
                                                          Unchecked="Options_Changed"
                                                          ToolTip="Compile the game with the bundled compiler. Off: only write the C++ project (to build later or look at)." />
                                                <CheckBox x:Name="ScanCheck" Content="Extra function discovery" Margin="0,10,0,0" Checked="Options_Changed"
                                                          Unchecked="Options_Changed"
                                                          ToolTip="Also look for code by its prologues. Try it when a game hits code the converter missed." />
                                                <CheckBox x:Name="ReleaseCheck" Content="Release build (faster game)" IsChecked="True" Margin="0,10,0,0"
                                                          Checked="Options_Changed" Unchecked="Options_Changed"
                                                          ToolTip="Optimised build. Off: a Debug build, slower but easier to debug." />
                                                <TextBlock Text="Runtime hints (interp_hits.txt from an earlier run, optional)" Style="{StaticResource Muted}"
                                                           FontSize="12" Margin="0,14,0,6" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HintsBox" />
                                                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseHints_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- Right: progress and log -->
                <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProgressTitle" Text="Ready" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ProgressDetail" Grid.Column="1" Style="{StaticResource Muted}" />
                            </Grid>
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Margin="0,14,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Border x:Name="Step0" Height="4" CornerRadius="2" Background="{StaticResource StepIdleBrush}" />
                                    <TextBlock x:Name="StepText0" Text="Read disc" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <Border x:Name="Step1" Height="4" CornerRadius="2" Background="{StaticResource StepIdleBrush}" />
                                    <TextBlock x:Name="StepText1" Text="Analyze" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <Border x:Name="Step2" Height="4" CornerRadius="2" Background="{StaticResource StepIdleBrush}" />
                                    <TextBlock x:Name="StepText2" Text="Generate code" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                    <Border x:Name="Step3" Height="4" CornerRadius="2" Background="{StaticResource StepIdleBrush}" />
                                    <TextBlock x:Name="StepText3" Text="Compile" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Border x:Name="Step4" Height="4" CornerRadius="2" Background="{StaticResource StepIdleBrush}" />
                                    <TextBlock x:Name="StepText4" Text="Done" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="18,12,12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Copy" Click="CopyLog_Click" MinHeight="30" />
                                <Button x:Name="OpenButton" Grid.Column="2" Content="Open output folder" Margin="8,0,0,0" MinHeight="30"
                                        IsEnabled="False" Click="OpenOutput_Click" />
                            </Grid>
                            <Border Background="{StaticResource LogBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,14,14">
                                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12.5" Padding="12,8" VerticalContentAlignment="Stretch"
                                         Foreground="#C9D1D9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Border>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ===== Batch convert ===== -->
            <Grid x:Name="BatchView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="18,16,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Queue" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="QueueSummary" Text="Empty" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="AddDiscsButton" Grid.Column="1" Content="Add discs…" Click="AddDiscs_Click" />
                            <Button x:Name="AddFolderButton" Grid.Column="2" Content="Add a folder…" Margin="8,0,0,0" Click="AddFolder_Click" />
                        </Grid>

                        <!-- Column headings -->
                        <Grid DockPanel.Dock="Top" Margin="18,0,16,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="GAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" />
                            <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" />
                            <TextBlock Grid.Column="3" Text="PROGRESS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" />
                        </Grid>

                        <Border DockPanel.Dock="Bottom" Margin="16,8,16,16" BorderBrush="{StaticResource InputLineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Background="#14171B">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Muted}"
                                       Text="Drop disc images or folders here to add them. Discs of one game are converted together." />
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10,16,10"
                                                Background="{Binding RowBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="13"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                                <ProgressBar Grid.Column="3" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1"
                                                             Foreground="{Binding StatusBrush}" Height="6" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Button Grid.Column="4" Style="{StaticResource LinkButton}" ToolTip="Remove from the queue"
                                                        Visibility="{Binding RemoveVisibility}" Click="RemoveItem_Click" Tag="{Binding}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{StaticResource FaintBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Right: settings, now converting, controls -->
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Button x:Name="StartBatchButton" Style="{StaticResource PrimaryButton}" Content="Start" Click="StartBatch_Click" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PauseButton" Content="Pause" IsEnabled="False" Click="PauseBatch_Click"
                                    ToolTip="Stop after this game; Start goes on with the rest" />
                            <Button x:Name="StopButton" Grid.Column="2" Content="Stop" IsEnabled="False" Click="StopBatch_Click"
                                    ToolTip="Stop after this game and leave the rest out" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Settings for all" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Save games to" Style="{StaticResource Muted}" Margin="0,14,0,6" />
                                    <TextBox x:Name="BatchOutBox" />
                                    <Button Content="Change…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BrowseBatchOut_Click" />
                                    <CheckBox x:Name="SkipCheck" IsChecked="True" Margin="0,16,0,0">
                                        <TextBlock Text="Skip games already converted" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox x:Name="KeepGoingCheck" IsChecked="True" Margin="0,10,0,0">
                                        <TextBlock Text="Keep going after a failure" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <Button x:Name="BatchAdvancedLink" Style="{StaticResource LinkButton}" Content="Advanced options…"
                                            Margin="0,14,0,0" HorizontalAlignment="Left" Click="BatchAdvanced_Click" />
                                    <StackPanel x:Name="BatchAdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                        <CheckBox Content="Build the .exe" IsChecked="{Binding IsChecked, ElementName=BuildCheck, Mode=TwoWay}" />
                                        <CheckBox Content="Extra function discovery" Margin="0,8,0,0"
                                                  IsChecked="{Binding IsChecked, ElementName=ScanCheck, Mode=TwoWay}" />
                                        <CheckBox Content="Release build" Margin="0,8,0,0"
                                                  IsChecked="{Binding IsChecked, ElementName=ReleaseCheck, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Now converting" Style="{StaticResource CardTitle}" />
                                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Show log" Click="ShowLog_Click" />
                                    </Grid>
                                    <TextBlock x:Name="NowTitle" Text="Nothing yet" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="NowStage" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    <ProgressBar x:Name="NowProgress" Minimum="0" Maximum="1" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
