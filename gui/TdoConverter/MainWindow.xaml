<Window x:Class="TdoConverter.MainWindow"
        Icon="pack://application:,,,/3do2pc.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3DO to PC" Width="900" Height="640" MinWidth="700" MinHeight="480">
    <DockPanel Margin="12">
        <!-- Inputs -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Disc image" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox x:Name="DiscBox" Grid.Column="1" Margin="0,0,0,6" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Browse…" Click="BrowseDisc_Click" />
                <Button Content="Inspect" Click="Inspect_Click" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox x:Name="OutBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseOut_Click" HorizontalAlignment="Left" Margin="4,0,0,6" />

            <TextBlock Grid.Row="2" Text="Game name" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                     ToolTip="Window title and .exe name. Leave empty to use the disc label." />

            <TextBlock Grid.Row="3" Text="Runtime hints" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox x:Name="HintsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                     ToolTip="interp_hits.txt written by a previous run of the converted game: those addresses get recompiled too." />
            <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Click="BrowseHints_Click" HorizontalAlignment="Left" Margin="4,0,0,6" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
            <CheckBox x:Name="BuildCheck" Content="Build .exe with local compiler" IsChecked="True" Margin="0,0,16,0" />
            <CheckBox x:Name="ScanCheck" Content="Extra function discovery" IsChecked="True" Margin="0,0,16,0" />
            <CheckBox x:Name="ReleaseCheck" Content="Release build" IsChecked="True" />
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ConvertButton" DockPanel.Dock="Right" Content="Convert" Click="Convert_Click" MinWidth="110" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open output" Click="OpenOutput_Click" IsEnabled="False" />
            <StackPanel>
                <TextBlock x:Name="StageText" Text="Ready" Margin="0,0,0,4" />
                <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="1" />
                <TextBlock x:Name="ToolchainText" Foreground="Gray" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Log -->
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
