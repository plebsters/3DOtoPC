# End-to-end: disc image -> converter -> local build -> run recompiled and interpreted.
if(NOT DEFINED EXPECT)
    set(EXPECT 16454)
endif()
if(FAKE_INPUT)
    set(ENV{TDORT_TEST_INPUT} 1)
endif()
math(EXPR EXPECT_RC "${EXPECT} & 255")
file(REMOVE_RECURSE ${OUT})
execute_process(COMMAND "${CONVERTER_EXE}" convert ${ISO} ${OUT} --runtime ${RUNTIME} --name E2E
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "convert failed (${rc})")
endif()
if(WIN32)
    set(EXE ${OUT}/E2E.exe)
else()
    set(EXE ${OUT}/E2E)
endif()
foreach(mode recompiled interpreted)
    set(args --headless --data ${OUT}/data)
    if(mode STREQUAL interpreted)
        list(APPEND args --interp)
    endif()
    execute_process(COMMAND ${EXE} ${args} WORKING_DIRECTORY ${OUT}
                    RESULT_VARIABLE rc ERROR_VARIABLE err)
    message("${mode}: exit=${rc}\n${err}")
    if(EXPECT_CRASH)
        if(NOT rc EQUAL 3 OR NOT err MATCHES "jump into the AIF header")
            message(FATAL_ERROR "${mode}: crash was not detected")
        endif()
        continue()
    endif()
    if(NOT rc EQUAL EXPECT_RC OR NOT err MATCHES "r0=${EXPECT}[^0-9]")
        message(FATAL_ERROR "${mode} run produced the wrong result")
    endif()
endforeach()
